{
  "name": "agbe-back",
  "version": "0.1.0",
  "private": true,
  "description": "AGBE — API (NestJS + Prisma + PostgreSQL)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node dist/scripts/seed.js",
    "admin:promote": "node dist/scripts/promote-admin.js",
    "admin:reset-totp": "node dist/scripts/reset-totp.js",
    "ledger:verify": "node dist/scripts/verify-ledger.js",
    "test:int": "TEST_DATABASE_URL=${TEST_DATABASE_URL:?set TEST_DATABASE_URL} vitest run"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "cookie-parser": "1.4.7",
    "geoip-country": "^5.0.202610280233",
    "helmet": "8.3.0",
    "nodemailer": "10.2.1",
    "otplib": "12.0.1",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.6",
    "@types/geoip-country": "^5.0.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "multer": "2.5.0",
    "ip-address": "10.7.5"
  }
}
