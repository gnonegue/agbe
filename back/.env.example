# --- AGBE API — copier en .env et remplir. Ne JAMAIS committer le .env. ---
NODE_ENV=development
PORT=3000

# PostgreSQL. En local sur socket Unix : postgresql://USER@localhost/agbe?host=/var/run/postgresql
DATABASE_URL=postgresql://agbe:CHANGE_ME@localhost:5432/agbe?schema=public

# Origines autorisées (CORS + vérification Origin), séparées par des virgules
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secrets : générer avec `openssl rand -base64 48`. Minimum 32 caractères.
JWT_ACCESS_SECRET=
# Clé de chiffrement des secrets 2FA (AES-256-GCM) : `openssl rand -base64 32` (exactement 32 octets)
TOTP_ENCRYPTION_KEY=

# Durées
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# Derrière un reverse proxy (nginx) : nombre de proxys de confiance
TRUST_PROXY_HOPS=1

# --- Paiement (paramétrable) ---
# mock (développement uniquement, refusé en production) | fedapay | cinetpay | ...
PAYMENT_PROVIDER=mock
# Paiement factice : autorisé UNIQUEMENT en local (refusé en production et si PUBLIC_APP_URL n'est pas localhost)
ALLOW_MOCK_PAYMENTS=true
# URL publique du front (retour après paiement)
PUBLIC_APP_URL=http://localhost:5173
# Liens des e-mails (réinitialisation du mot de passe) quand le jeu est ouvert par un tunnel HTTPS de test
# (ex. https://xxx.trycloudflare.com) : à changer à chaque nouveau tunnel. Vide = PUBLIC_APP_URL.
MAIL_LINK_URL=
# URL publique de l'API (notification webhook de l'opérateur)
PUBLIC_API_URL=http://localhost:3000
# Secrets du fournisseur choisi (laissés vides tant qu'aucun n'est retenu)
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- E-mails (mot de passe oublié) : SMTP ---
# Laisser SMTP_HOST vide = aucun e-mail envoyé (en développement, le message s'affiche dans la console du serveur,
# lien compris). Renseigner les valeurs données par ton fournisseur (Brevo, Mailjet, Amazon SES, Gmail/Google Workspace,
# OVH, Zoho…). Port 587 + SMTP_SECURE=false (STARTTLS) ou port 465 + SMTP_SECURE=true (TLS direct).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur : l'adresse doit appartenir à un domaine validé chez le fournisseur (SPF/DKIM), ex. AGBE <no-reply@agbe.tg>
MAIL_FROM=

# --- Connexion avec Google (facultative) ---
# Console Google Cloud > API et services > Identifiants > « ID client OAuth » de type « Application Web ».
# URI de redirection autorisé : <PUBLIC_APP_URL>/api/auth/google/callback
#   (développement : http://localhost:5173/api/auth/google/callback ; production : https://votre-domaine/api/auth/google/callback)
# Sans ces deux variables, le bouton « Continuer avec Google » n'apparaît pas.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Initialisation (page /init) ---
# Mot de passe demandé par https://votre-domaine/init pour créer les tables, charger les données du jeu et le premier
# administrateur. 16 caractères au moins (openssl rand -base64 24). Vide = page désactivée : à vider après l'initialisation.
INIT_SECRET=
